# C style for lib/. clang-format is pinned in the dev dependency group so that
# local and CI output match:
#   uv run clang-format -i lib/*.c lib/*.h
---
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 80
# Preprocessor directives, including "#pragma omp", sit flush left.
IndentPPDirectives: None
